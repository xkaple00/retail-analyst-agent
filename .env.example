# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Your own GCP project, used for BigQuery billing/quota (the dataset is public)
GOOGLE_CLOUD_PROJECT=
# Models (any Gemini model usable with an AI Studio key)
ANALYST_MODEL=gemini-3.8-flash
ANALYST_FALLBACK_MODEL=gemini-3.5-flash-lite
ANALYST_GUARD_MODEL=gemini-3.5-flash-lite
# Judge model for evals/run_evals.py (ideally not the model that answers)
ANALYST_JUDGE_MODEL=gemini-3.8-flash
# Cost caps
MAX_BYTES_PER_QUERY=2000000000
QUERY_TIMEOUT_S=60
# Per-user daily budgets, 0 = unlimited (tokens and BigQuery bytes summed over today's traces)
DAILY_TOKEN_BUDGET=0
DAILY_BYTES_BUDGET=0
# Guard behaviour when the classifier model is down: false = rules decide (default), true = refuse
GUARD_FAIL_CLOSED=false
# Where sqlite, traces and reports live
ANALYST_DATA_DIR=./data
# Optional: service-account key for BigQuery instead of gcloud application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
