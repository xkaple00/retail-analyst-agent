# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Your own GCP project, used for BigQuery billing/quota (the dataset is public)
GOOGLE_CLOUD_PROJECT=
# Models (any Gemini model usable with an AI Studio key)
ANALYST_MODEL=gemini-3.8-flash
# Fallback chain, comma-separated, tried in order when the model above fails or hangs
ANALYST_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
ANALYST_GUARD_MODEL=gemini-3.5-flash-lite
# Judge model for evals/run_evals.py (ideally not the model that answers)
ANALYST_JUDGE_MODEL=gemini-3.8-flash
# Cost caps
MAX_BYTES_PER_QUERY=2000000000
QUERY_TIMEOUT_S=60
# One model call may take at most LLM_TIMEOUT_S; a hung or failing primary is skipped for LLM_PRIMARY_COOLDOWN_S
LLM_TIMEOUT_S=25
LLM_PRIMARY_COOLDOWN_S=300
# Per-user daily budgets, 0 = unlimited (tokens and BigQuery bytes summed over today's traces)
DAILY_TOKEN_BUDGET=0
DAILY_BYTES_BUDGET=0
# Guard behaviour when the classifier model is down: false = rules decide (default), true = refuse
GUARD_FAIL_CLOSED=false
# Cost model: estimated cost per turn is stored in the trace; a turn above the cap is flagged (client: $1/question)
COST_PER_QUESTION_USD=1.0
PRICE_PER_M_INPUT_TOKENS=0.30
PRICE_PER_M_OUTPUT_TOKENS=2.50
PRICE_PER_TB_BIGQUERY=6.25
# Retention, purged at startup (client: chat 90 days, audit log 1 year, reports until the user deletes them)
CHAT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Fallback stays within Gemini models (client default). A second provider is listed but switched off.
ANALYST_SECOND_PROVIDER=anthropic-vertex
ANALYST_SECOND_PROVIDER_ENABLED=false
# Where sqlite, traces and reports live
ANALYST_DATA_DIR=./data
# Optional: service-account key for BigQuery instead of gcloud application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
